APP_ENV=production

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

LLM_TIMEOUT=45
LLM_MAX_RETRIES=3

WECHAT_AUTO_REPLY=true

ENABLE_PRIVATE_CHAT=true
ENABLE_GROUP_CHAT=false

MAX_CONTEXT_MESSAGES=20
MAX_REPLY_LENGTH=120

MESSAGE_DEBOUNCE_MIN=3
MESSAGE_DEBOUNCE_MAX=8

REPLY_MIN_DELAY=3
REPLY_MAX_DELAY=8

HIGH_RISK_MODE=block

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

LOG_LEVEL=INFO
